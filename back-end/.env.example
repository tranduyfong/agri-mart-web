PORT=8000
NODE_ENV=development

# Điền URI Atlas sau. URI không được commit lên Git.
MONGODB_URL=

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
EMAIL_USER=
EMAIL_PASS=
# URL API công khai để khách mở liên kết hủy đăng ký trong email.
PUBLIC_API_URL=http://localhost:8000/api

# VNPay Sandbox - chỉ đặt thông tin merchant trong backend.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/vnpay-return
VNP_TEST_MODE=true
SHIPPING_FEE=15000

